  "messages": [
    { "message_id": "33333333-0000-0000-0000-000000000001", "session_id": "22222222-0000-0000-0000-000000000001", "role": "user",      "content": "Hi, I'm Aarav. I work as a backend engineer at Fusemachines in Kathmandu.", "created_at": "2026-07-01T09:02:10Z" },
    { "message_id": "33333333-0000-0000-0000-000000000002", "session_id": "22222222-0000-0000-0000-000000000001", "role": "assistant", "content": "Nice to meet you, Aarav! I've noted that you're a backend engineer at Fusemachines in Kathmandu.", "created_at": "2026-07-01T09:02:14Z" },
    { "message_id": "33333333-0000-0000-0000-000000000003", "session_id": "22222222-0000-0000-0000-000000000001", "role": "user",      "content": "I prefer Python over Java, and I'm vegetarian.", "created_at": "2026-07-01T09:03:40Z" },
    { "message_id": "33333333-0000-0000-0000-000000000004", "session_id": "22222222-0000-0000-0000-000000000001", "role": "assistant", "content": "Got it — Python preferred over Java, and vegetarian diet.", "created_at": "2026-07-01T09:03:44Z" },

    { "message_id": "33333333-0000-0000-0000-000000000010", "session_id": "22222222-0000-0000-0000-000000000002", "role": "user",      "content": "I'm planning a trip to Pokhara next month, goal is to finish it by end of August.", "created_at": "2026-07-14T18:20:30Z" },
    { "message_id": "33333333-0000-0000-0000-000000000011", "session_id": "22222222-0000-0000-0000-000000000002", "role": "assistant", "content": "Noted — trip to Pokhara, target completion end of August 2026.", "created_at": "2026-07-14T18:20:35Z" },
    { "message_id": "33333333-0000-0000-0000-000000000012", "session_id": "22222222-0000-0000-0000-000000000002", "role": "user",      "content": "Also, never book me a window seat, I get motion sick.", "created_at": "2026-07-14T18:22:00Z" },
    { "message_id": "33333333-0000-0000-0000-000000000013", "session_id": "22222222-0000-0000-0000-000000000002", "role": "assistant", "content": "Understood — no window seats, ever. I'll treat that as a standing rule.", "created_at": "2026-07-14T18:22:05Z" },
    { "message_id": "33333333-0000-0000-0000-000000000014", "session_id": "22222222-0000-0000-0000-000000000002", "role": "user",      "content": "Attended the Nepal AI Summit 2026 in Pokhara last week, it was great.", "created_at": "2026-07-14T18:25:00Z" },

    { "message_id": "33333333-0000-0000-0000-000000000020", "session_id": "22222222-0000-0000-0000-000000000003", "role": "user",      "content": "Update: I actually left Fusemachines. I'm now a backend engineer at LeapFrog Technology.", "created_at": "2026-08-05T11:10:20Z" },
    { "message_id": "33333333-0000-0000-0000-000000000021", "session_id": "22222222-0000-0000-0000-000000000003", "role": "assistant", "content": "Thanks for letting me know — I've updated your employer to LeapFrog Technology and archived the old record.", "created_at": "2026-08-05T11:10:25Z" }
