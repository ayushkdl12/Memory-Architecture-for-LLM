# LLM backend: "ollama" (default, fully local, no key) or "gemini" (requires key below)
LLM_PROVIDER=ollama

# --- Local Ollama (default) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=llama3.2:3b
# OLLAMA_EMBED_MODEL=all-minilm

# --- Gemini (opt-in: set LLM_PROVIDER=gemini and paste your key) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# DATABASE_URL=postgresql+psycopg2://memory:memory_pass@localhost:5432/memory_db
